# Secrets and credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
vault/
**/wallet.json
**/*private*key*
config/halt.flag
config/llm/disabled.flag

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# uv
.uv-cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local object-store / DB volumes (if bind-mounted)
.local-data/

# Generated Market Pulse briefs (keep the directory README and committed DoD samples)
briefs/**
!briefs/README.md
!briefs/*/
!briefs/*/us-pre-market.md

# Generated source-health reports (keep README and committed dated samples)
ops/reports/source-health/**
!ops/reports/source-health/README.md
!ops/reports/source-health/*.md
!ops/reports/source-health/*.sha256

# Generated scheduler miss-check incidents (keep README + committed reports)
ops/reports/scheduler/incidents/**
!ops/reports/scheduler/incidents/README.md

# Scheduler completion rows (IMP-046 / B1 Stage 1) are committed on purpose so the
# box can `git pull` and miss-check can read them. Actions stamps + Hive stamps
# under ops/reports/scheduler/completions/*.json are durable SoT (not gitignored).

# known-missed baseline (IMP-056). History labeled, not deleted. Do not commit generated YAML.
ops/reports/scheduler/known-missed-baseline.yaml
ops/reports/scheduler/known-missed-baseline.yml

# Standalone Phase-1 base-rate bar cache (raw vendor series; not a desk artifact)
research/base-rates/cache/

# Generated Post-IPO reclaim screens (keep README and committed dated samples)
research/screens/post-ipo-reclaim/**
!research/screens/post-ipo-reclaim/README.md
!research/screens/post-ipo-reclaim/*.md
!research/screens/post-ipo-reclaim/*.meta.json
