# Local development placeholders only.
# Copy to `.env` if you need overrides. Never commit `.env`.
# Do not put Hyperliquid keys, API wallets, or treasury material here.

LAB_ENV=dev
POSTGRES_DSN=postgresql://lab:lab@localhost:5432/market_memory

# Durable raw-object store (required for real ingest unless you pass --no-objects).
# Local compose MinIO credentials are dev conveniences, not production secrets.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=market-memory
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Object-store backend (default: s3 / MinIO). Incomplete MinIO/S3 env now FAILS CLOSED
# instead of silently using process-local memory.
# MM_OBJECT_STORE=s3
#
# Development-only in-memory bytes (NOT durable; gone after process exit):
# MM_OBJECT_STORE=memory
#
# Durable local filesystem instead of MinIO/S3:
# MM_OBJECT_STORE=filesystem
# MM_OBJECT_STORE_PATH=/var/lib/market-memory/objects
#
# Disable raw objects (same as `lab ingest --no-objects`; observations persist without pointers):
# MM_OBJECT_STORE=none

# HL_INFO_URL defaults to https://api.hyperliquid.xyz/info (public, no key)
# Optional macro (Phase 3 / Pulse). Request a key at https://fred.stlouisfed.org/docs/api/api_key.html
# then export it in the shell, put it in gitignored `.env`, or store it as a GitHub Actions
# repository secret named FRED_API_KEY. Never commit the value. Missing → Pulse/source-health
# mark FRED unavailable (error_class=missing_env); they do not invent a yield.
# FRED_API_KEY=

# Optional equities (Phase 5b). Polygon is the Principal-locked default vendor (Ask is N/A).
# Create a key at https://polygon.io and export POLYGON_API_KEY locally or as a CI secret.
# Never commit the value. Missing → Polygon ingest/source-health unavailable (error_class=missing_env);
# no OHLCV invented. Free-tier rate limit is configured in config/ingest.yaml (5 req/min default).
# POLYGON_API_KEY=
